<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="dynamic_human_world">
    <!-- 1. Required Systems/Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />

    <!-- 2. Environmental lighting and ground -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0.0 0.0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0.0 0.0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 3. Dynamic Walking Actor -->
    <actor name="actor_walking_1">
      <!-- Visual appearance mesh (downloaded automatically from Gazebo Fuel) -->
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      
      <!-- Skeletal animation (synchronized with trajectory) -->
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      
      <!-- Loop trajectory in a square (X: 3 to 5, Y: 4 to 6) -->
      <script>
        <loop>true</loop>
        <delay_start>0.000000</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint>
            <time>0.0</time>
            <pose>3.0 4.0 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>2.0</time>
            <pose>5.0 4.0 1.0 0 0 0</pose>
          </waypoint>
          <waypoint>
            <time>2.5</time>
            <pose>5.0 4.0 1.0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>4.5</time>
            <pose>5.0 6.0 1.0 0 0 1.57</pose>
          </waypoint>
          <waypoint>
            <time>5.0</time>
            <pose>5.0 6.0 1.0 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>7.0</time>
            <pose>3.0 6.0 1.0 0 0 3.142</pose>
          </waypoint>
          <waypoint>
            <time>7.5</time>
            <pose>3.0 6.0 1.0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>9.5</time>
            <pose>3.0 4.0 1.0 0 0 -1.57</pose>
          </waypoint>
          <waypoint>
            <time>10.0</time>
            <pose>3.0 4.0 1.0 0 0 0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- 4. Additional spread-out human actors with varied motion patterns -->
    <actor name="actor_walking_2">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.2</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.0">
          <waypoint><time>0.0</time><pose>-2.0 2.0 1.0 0 0 0.0</pose></waypoint>
          <waypoint><time>2.0</time><pose>1.0 2.0 1.0 0 0 0.0</pose></waypoint>
          <waypoint><time>2.5</time><pose>1.0 2.0 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>4.5</time><pose>1.0 4.5 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>5.0</time><pose>1.0 4.5 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>7.0</time><pose>-2.0 4.5 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>7.5</time><pose>-2.0 4.5 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>9.5</time><pose>-2.0 2.0 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>10.0</time><pose>-2.0 2.0 1.0 0 0 0.0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="actor_walking_3">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.4</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.0">
          <waypoint><time>0.0</time><pose>6.0 -2.0 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>2.0</time><pose>8.0 -2.0 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>2.5</time><pose>8.0 -2.0 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>4.5</time><pose>8.0 -4.5 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>5.0</time><pose>8.0 -4.5 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>7.0</time><pose>6.0 -4.5 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>7.5</time><pose>6.0 -4.5 1.0 0 0 0.0</pose></waypoint>
          <waypoint><time>9.5</time><pose>6.0 -2.0 1.0 0 0 0.0</pose></waypoint>
          <waypoint><time>10.0</time><pose>6.0 -2.0 1.0 0 0 1.57</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="actor_walking_4">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.6</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.0">
          <waypoint><time>0.0</time><pose>-4.5 -3.5 1.0 0 0 0.0</pose></waypoint>
          <waypoint><time>1.8</time><pose>-2.5 -3.5 1.0 0 0 0.0</pose></waypoint>
          <waypoint><time>2.3</time><pose>-2.5 -3.5 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>4.3</time><pose>-2.5 -5.8 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>4.8</time><pose>-2.5 -5.8 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>6.8</time><pose>-4.5 -5.8 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>7.3</time><pose>-4.5 -5.8 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>9.3</time><pose>-4.5 -3.5 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>10.0</time><pose>-4.5 -3.5 1.0 0 0 0.0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="actor_walking_5">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.8</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.0">
          <waypoint><time>0.0</time><pose>2.5 5.5 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>2.0</time><pose>0.5 5.5 1.0 0 0 3.14</pose></waypoint>
          <waypoint><time>2.5</time><pose>0.5 5.5 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>4.5</time><pose>0.5 7.8 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>5.0</time><pose>0.5 7.8 1.0 0 0 0.0</pose></waypoint>
          <waypoint><time>7.0</time><pose>2.5 7.8 1.0 0 0 0.0</pose></waypoint>
          <waypoint><time>7.5</time><pose>2.5 7.8 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>9.5</time><pose>2.5 5.5 1.0 0 0 1.57</pose></waypoint>
          <waypoint><time>10.0</time><pose>2.5 5.5 1.0 0 0 3.14</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <actor name="actor_walking_6">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>1.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.0">
          <waypoint><time>0.0</time><pose>4.5 3.2 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>1.8</time><pose>6.2 3.2 1.0 0 0 -1.57</pose></waypoint>
          <waypoint><time>2.3</time><pose>6.2 3.2 1.0 0 0 0.0</pose></waypoint>
          <waypoint><time>4.3</time><pose>6.2 1.0 1.0 0 0 0.0</pose></waypoint>
          <waypoint><time>4.8</time><pose>6.2 1.0 1.0 0 0 1.57</pose></waypoint>
