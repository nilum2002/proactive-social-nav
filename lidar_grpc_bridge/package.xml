<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lidar_grpc_bridge</name>
  <version>0.1.0</version>
  <description>
    Bridges ROS2 sensor_msgs/LaserScan onto a gRPC server-streaming service, so an
    off-board consumer (e.g. the DR-SPAAM inference host) can pull live scans over the
    network without running ROS2 itself.
  </description>
  <maintainer email="didulahirupama28@gmail.com">nilum2002</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>proactive_nav_msgs</depend>
  <exec_depend>python3-grpcio</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
