<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inf_server_wifi</name>
  <version>0.1.0</version>
  <description>
    Plain-DDS server: DR-SPAAM + Kalman tracking on the LaserScan and Odometry
    that inf_client_wifi republishes across the WiFi link. The DDS sibling of
    inf_server (gRPC/TCP) and inf_server_udp (raw datagrams) -- the control
    condition those two are measured against, with no custom transport at all.
  </description>
  <maintainer email="sachithyanilum@gmail.com">nilum</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
